# ========================================
# PhishARG Backend — Variables de Entorno
# ========================================
# Copiar este archivo como .env y ajustar los valores.
# NUNCA subir .env a Git (está en .gitignore).

# --- Servidor ---
HOST=0.0.0.0
PORT=8001
DEBUG=true

# --- CORS ---
# Orígenes permitidos (separados por coma). Usar * solo en desarrollo.
# En producción, restringir al dominio de Vercel y del piloto:
# CORS_ORIGINS=https://add-in-pfi.vercel.app,https://add-in-pfi-hybrid.vercel.app
CORS_ORIGINS=*

# --- Autenticación de Tokens HMAC (Piloto Híbrido) ---
# PHISHARG_TOKEN_KEY=clave_secreta_compartida_con_vercel

# --- Hugging Face Inference API ---
# Token de acceso con permisos de lectura.
# Generalo en: https://huggingface.co/settings/tokens
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ID del modelo en Hugging Face Hub
HF_MODEL_ID=Gabo1646/phisharg-distilbert

# (Opcional) URL del endpoint. Se genera automáticamente desde HF_MODEL_ID.
# Solo cambiar si usás un endpoint dedicado (Inference Endpoints).
# HF_API_URL=https://api-inference.huggingface.co/models/Gabo1646/phisharg-distilbert

# Ruta Hybrid V3 usada por el Add-in de Outlook.
# Configurar las rutas absolutas del artefacto Hybrid y del GGUF de Qwen.
# PHISHARG_HYBRID_MODEL_DIR=/models/hybrid-v3
# PHISHARG_SLM_MODEL_PATH=/models/qwen2.5-3b-instruct-q4_k_m.gguf
# LIME se ejecuta para alertas; ?include_lime=false lo desactiva si se necesita.
# Si Qwen falla o su salida no supera la validación, se devuelve una explicación segura.
