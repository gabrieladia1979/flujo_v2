# ========================================
# PhishARG Backend — Variables de Entorno
# ========================================
# Copiar este archivo como .env y ajustar los valores.
# NUNCA subir .env a Git (está en .gitignore).

# --- Servidor ---
HOST=0.0.0.0
PORT=8001
DEBUG=true

# --- Clasificador XGBoost ---
# Vacío/ausente: conserva el pickle histórico en model/phisharg_xgboost.pkl.
# La ruta relativa se resuelve desde la raíz del proyecto, no desde el cwd.
# Activar solo después de generar y evaluar el candidato local:
# PFI_CLASSIFIER_MODEL_PATH=artifacts/audit-candidate-v2/phisharg_xgboost.pkl

# --- Add-in publicado / AWS ---
# En producción se requieren API_KEY y PHISHARG_TOKEN_KEY de al menos 32
# caracteres (en Secrets Manager), y una tabla compartida de nonces usados.
# PHISHARG_ENV=production
# PHISHARG_TOKEN_KEY=<secreto de servidor; nunca compilar en el add-in>
# PHISHARG_REPLAY_TABLE=<tabla DynamoDB, partition key nonce, TTL expires_at>
# PHISHARG_CORS_ORIGINS=https://add-in-pfi-hybrid.vercel.app

# --- CORS ---
# Orígenes permitidos (separados por coma). Usar * solo en desarrollo.
# En producción, restringir al dominio de Vercel:
# CORS_ORIGINS=https://add-in-pfi.vercel.app
CORS_ORIGINS=*

# --- Hugging Face Inference API ---
# Token de acceso con permisos de lectura.
# Generalo en: https://huggingface.co/settings/tokens
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ID del modelo en Hugging Face Hub
HF_MODEL_ID=Gabo1646/phisharg-distilbert

# (Opcional) URL del endpoint. Se genera automáticamente desde HF_MODEL_ID.
# Solo cambiar si usás un endpoint dedicado (Inference Endpoints).
# HF_API_URL=https://api-inference.huggingface.co/models/Gabo1646/phisharg-distilbert

# Fargate: configurar mediante task definition + Secrets Manager.
# CLASSIFIER_BOOTSTRAP_ON_START=true
# CLASSIFIER_MODEL_S3_BUCKET=<bucket privado versionado>
# CLASSIFIER_MODEL_S3_KEY=xgboost/audit-candidate-v2/20261126/model.zip
# CLASSIFIER_MODEL_S3_VERSION_ID=<version inmutable, no null>
# CLASSIFIER_BUNDLE_SHA256=0a0f9c94cda222cf18a50ae57eb2275caf468ec27c404ff7855cc8a2869c0ff6
# CLASSIFIER_MODEL_SHA256=d176ffcbede82073a83e39139da8ee00665adeb4a6a60508c6cd51561a191728
# PFI_CLASSIFIER_MODEL_PATH=/app/artifacts/audit-candidate-v2/phisharg_xgboost.pkl
# PRELOAD_SLM=true
# MODEL_BOOTSTRAP_ON_START=true
# La task definition conserva S3 VersionId y SHA-256 del GGUF existente.
