# ========================================
# PhishARG Backend — Variables de Entorno
# ========================================
# Copiar este archivo como .env y ajustar los valores.
# NUNCA subir .env a Git (está en .gitignore).

# --- Servidor ---
HOST=0.0.0.0
PORT=8001
DEBUG=true

# --- CORS ---
# Orígenes permitidos (separados por coma). Usar * solo en desarrollo.
# En producción, restringir al dominio de Vercel:
# CORS_ORIGINS=https://add-in-pfi.vercel.app
CORS_ORIGINS=*

# --- Hugging Face Inference API ---
# Token de acceso con permisos de lectura.
# Generalo en: https://huggingface.co/settings/tokens
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ID del modelo en Hugging Face Hub
HF_MODEL_ID=Gabo1646/phisharg-distilbert

# (Opcional) URL del endpoint. Se genera automáticamente desde HF_MODEL_ID.
# Solo cambiar si usás un endpoint dedicado (Inference Endpoints).
# HF_API_URL=https://api-inference.huggingface.co/models/Gabo1646/phisharg-distilbert

# Optional: enables only POST /api/v1/analyze/hybrid; legacy route stays unchanged.
# Requires the hybrid environment and a completed, verified local artifact.
# PHISHARG_HYBRID_MODEL_DIR=artifacts/hybrid/multilingual-candidate-v1
